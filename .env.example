# Ambiente local. O `make dev` ja exporta o que precisa; o arquivo existe para quem quiser
# rodar os comandos na mao.

# Modo padrao: sem AWS nenhuma. Com SNAPSHOT_PATH preenchido a API le o snapshot do disco,
# e nada mais e necessario para o endpoint responder.
SNAPSHOT_PATH=.local/snapshot/pools.json.gz

# Modo `make dev-aws`, contra o LocalStack. Deixe SNAPSHOT_PATH vazio para usar o S3.
# AWS_ENDPOINT_URL aponta o boto3 inteiro para o LocalStack e e suportado pelo botocore,
# entao o codigo nao precisa saber que esta em ambiente local.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# AWS_DEFAULT_REGION=us-east-1
# SNAPSHOT_BUCKET=pool-selection-local
# SNAPSHOT_KEY=snapshot/pools.json.gz
# COUNTERS_TABLE=pool-selection-counters

# Sem isso a API responde 503 quando nao ha snapshot nenhum, em vez de cair na lista
# estatica. Em producao a lista vem do Terraform.
FALLBACK_POOLS=pool-r6.xlarge-us-east-1a,pool-c6.xlarge-us-east-1a

# Calibracao do modelo. Sao os valores padrao, repetidos aqui para ficarem visiveis.
TIMED_OUT_WEIGHT=0.5
SNAPSHOT_TTL_SECONDS=30
PLACEMENT_REFRESH_SECONDS=300

# Folga antes de dar um minuto por fechado, para o contador atrasado nao se perder.
AGGREGATOR_LAG_MINUTES=2

# Quanta folga um pool precisa ter, em relacao ao candidato mais folgado, para poder
# receber todo o trafego. Menor concentra mais, maior espalha mais.
CAPACITY_CONCENTRATION=3.0
